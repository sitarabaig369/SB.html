    const categoriesList = ["All Tools", ...new Set(toolsData.map(t => t.category))];

    function renderCategories() {
      const container = document.getElementById('categories');
      container.innerHTML = categoriesList.map(cat => {
        const count = cat === "All Tools" ? toolsData.length : toolsData.filter(t => t.category === cat).length;
        return `<button class="cat-btn ${cat === 'All Tools' ? 'active' : ''}" data-cat="${cat}">
          ${cat} <span class="cat-count">${count}</span>
        </button>`;
      }).join('');
    }

    /* ============================================================
       RENDER TOOLS
    ============================================================ */
    let activeCategory = "All Tools";
    let searchTerm = "";

    function renderTools() {
      const grid = document.getElementById('toolsGrid');
      let filtered = toolsData;

      if (activeCategory !== "All Tools") {
        filtered = filtered.filter(t => t.category === activeCategory);
      }

      if (searchTerm.trim()) {
        const q = searchTerm.toLowerCase();
        filtered = filtered.filter(t =>
          t.name.toLowerCase().includes(q) ||
          t.desc.toLowerCase().includes(q) ||
          t.category.toLowerCase().includes(q)
        );
      }

      document.getElementById('currentCategoryLabel').textContent =
        searchTerm ? `Search: "${searchTerm}"` : activeCategory;
      document.getElementById('toolCountLabel').textContent =
        `${filtered.length} tool${filtered.length !== 1 ? 's' : ''} available`;

      if (filtered.length === 0) {
        grid.innerHTML = `
          <div class="empty-state">
            <span class="emoji">🔍</span>
            <h3>No tools found</h3>
            <p>Try a different search term or category.</p>
          </div>`;
        return;
      }

      grid.innerHTML = filtered.map(tool => `
        <a href="${tool.link}" class="tool-card">
          <div class="tool-icon">${tool.icon}</div>
          <div class="tool-body">
            <div class="tool-title">${tool.name}</div>
            <div class="tool-desc">${tool.desc}</div>
          </div>
          ${tool.badge ? `<span class="tool-badge ${tool.badge}">${tool.badge === 'hot' ? '🔥 Hot' : tool.badge === 'new' ? '✨ New' : ''}</span>` : ''}
        </a>
      `).join('');
    }

    /* ============================================================
       CATEGORY CLICK
    ============================================================ */
    document.getElementById('categories').addEventListener('click', (e) => {
      const btn = e.target.closest('.cat-btn');
      if (!btn) return;
      document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeCategory = btn.dataset.cat;
      searchTerm = "";
      document.getElementById('searchBox').value = "";
      renderTools();
    });

    /* ============================================================
       SEARCH
    ============================================================ */
    let searchTimeout;
    document.getElementById('searchBox').addEventListener('input', (e) => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        searchTerm = e.target.value;
        if (searchTerm.trim()) {
          activeCategory = "All Tools";
          document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
          document.querySelector('.cat-btn[data-cat="All Tools"]').classList.add('active');
        }
        renderTools();
      }, 150);
    });

    /* ============================================================
